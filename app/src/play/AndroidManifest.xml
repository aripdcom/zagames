<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Play Billing, Google'ın datatransport telemetri hattını da çekiyor
         (transport-backend-cct) ve o kütüphane İNTERNET ile ağ durumu izinlerini
         ekliyor. Satın alma Play Store uygulamasıyla cihaz içi IPC üzerinden
         konuşur, ağ izni gerekmez; ZA'nın "internet yok" sözü play çeşidinde de
         kalsın diye ikisi birleştirmede çıkarılır. Kalan tek ek izin
         com.android.vending.BILLING. Kapalı testte doğrulama: store/checklist.md §8. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

</manifest>
